input_norm = normalization(
    [123.675, 116.280, 103.530],
    [58.395, 57.120, 57.375]
)

model_optimization_flavor(optimization_level=0, compression_level=4, batch_size=1)
# post_quantization_optimization(adaround, batch_size=1)

# These are the 12 attention-value matmuls. Their first input is a native
# softmax and therefore mathematically lies in [0, 1]. Force that full range so
# a narrow calibration sample cannot produce an unsupported matmul scale delta.
quantization_param(
    [matmul2, matmul4, matmul6, matmul8, matmul10, matmul12,
     matmul14, matmul16, matmul18, matmul20, matmul22, matmul24],
    force_range_in=[0.0, 1.0],
    force_range_index=[0]
)
